# ===========================================================================
# AI LaunchPad: Growth Engine Environment Configuration
# ===========================================================================

# 1. DATABASE CONFIGURATION (Supabase / PostgreSQL)
# Required if running the full-stack Express API server with PostgreSQL.
# In standalone mode (Vite), the frontend uses the built-in MockGrowthEngine in localStorage.
DATABASE_URL=postgresql://postgres.your-supabase-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# 2. APPLICATION PORTS & PATHS
PORT=3000
BASE_PATH=/

# 3. OPTIONAL CLERK AUTHENTICATION
# If provided, Clerk authentication is automatically enabled.
# If omitted or empty, AI LaunchPad runs in zero-friction Standalone Operator Mode
# with a 1-click evaluator sign-in button.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
AI_LAUNCHPAD_ADMIN_USER_IDS=user_admin_demo

